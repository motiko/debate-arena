{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "debate-arena-web",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "binding": "ASSETS" },
  // /api/* is forwarded to the API Worker (same origin). Locally the API runs in its own `wrangler dev`.
  "services": [{ "binding": "API", "service": "debate-arena-api" }],
  // Bindings are not inherited by environments, so production repeats them.
  "env": {
    "production": {
      // Without a name of its own, the production build would be "debate-arena-web-production".
      "name": "debate-arena-web",
      "assets": { "directory": "./dist/client", "binding": "ASSETS" },
      // `wrangler deploy --env production` deploys the API as "debate-arena-api-production".
      "services": [{ "binding": "API", "service": "debate-arena-api-production" }],
      // Cookieless page views, counted on the server (no client script, no cookie, no personal data).
      "analytics_engine_datasets": [{ "binding": "ANALYTICS", "dataset": "debate_arena_pageviews" }]
    }
  }
}
