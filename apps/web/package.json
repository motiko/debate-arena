{
  "name": "@debate-arena/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "CLOUDFLARE_DEV_REGISTRY_PATH=../../.wrangler/dev-registry astro dev --port 4321",
    "build": "astro build",
    "preview": "CLOUDFLARE_DEV_REGISTRY_PATH=../../.wrangler/dev-registry astro preview --port 4321",
    "typecheck": "astro check && svelte-check --fail-on-warnings",
    "test": "vitest run",
    "e2e": "playwright test",
    "lighthouse": "node scripts/lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@astrojs/svelte": "^9.1.6",
    "@debate-arena/api-client": "workspace:*",
    "@debate-arena/engine": "workspace:*",
    "astro": "^7.4.12",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^31.0.1",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  }
}
