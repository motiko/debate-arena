---
// The feed's search bar (plain GET, so it works without JavaScript), with every other filter folded behind the
// filter icon at its end. The Tags are a list of checkboxes, so several can be chosen without JavaScript; with it,
// a box above them narrows the list as you type.
import { t } from '../i18n/t';
import { modelLabel, type ModelInfo } from '../lib/debate';
import { CATEGORIES, MAX_FILTER_TAGS, categoryLabel, type FeedParams } from '../lib/feed';

interface Props {
  params: FeedParams;
  /** The models offered in the Debater filter. */
  models: ModelInfo[];
  /** Every model's name, to show a filtered model that is not offered. */
  allModels: ModelInfo[];
  popularTags: string[];
}

const { params, models, allModels, popularTags } = Astro.props;
const offered = params.model && !models.some(m => m.id === params.model) ? [...models, { id: params.model, label: modelLabel(params.model, allModels) }] : models;
// The chosen Tags first, so they are in view when the panel opens; one reached from an entry may not be a popular one.
const chosen = params.tags ?? [];
const tags = [...chosen, ...popularTags.filter(tag => !chosen.includes(tag))];
const folded = [params.category, params.model, params.kind].filter(Boolean).length + chosen.length;
---

<form class="search" role="search" method="get" action="/">
  <div class="bar">
    <label for="feed-q" class="visually-hidden">{t('feed.searchLabel')}</label>
    <input id="feed-q" type="search" name="q" value={params.q ?? ''} maxlength="100" autocomplete="off" placeholder={t('feed.searchPlaceholder')} />
    <button type="submit" class="go" aria-label={t('feed.search')}>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
        <circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
    <details class="more">
      <summary aria-label={folded > 0 ? `${t('feed.moreFilters')}, ${folded} ${t('feed.applied')}` : t('feed.moreFilters')} title={t('feed.moreFilters')}>
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
          <circle cx="7" cy="5.5" r="2" fill="var(--knob)" stroke="currentColor" stroke-width="1.75"></circle>
          <circle cx="13" cy="10" r="2" fill="var(--knob)" stroke="currentColor" stroke-width="1.75"></circle>
          <circle cx="8.5" cy="14.5" r="2" fill="var(--knob)" stroke="currentColor" stroke-width="1.75"></circle>
        </svg>
        {folded > 0 && <span class="applied" aria-hidden="true">{folded}</span>}
      </summary>
      <div class="panel">
        <div class="fields">
          <div class="field">
            <label for="feed-category">{t('feed.categoryLabel')}</label>
            <select id="feed-category" name="category">
              <option value="">{t('feed.anyCategory')}</option>
              {CATEGORIES.map(category => <option value={category} selected={params.category === category}>{categoryLabel(category)}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="feed-model">{t('feed.modelLabel')}</label>
            <select id="feed-model" name="model">
              <option value="">{t('feed.anyModel')}</option>
              {offered.map(m => <option value={m.id} selected={params.model === m.id}>{m.label}</option>)}
            </select>
          </div>
          <label class="choice">
            <input type="checkbox" name="kind" value="batch" checked={params.kind === 'batch'} />
            {t('feed.slowOnly')}
          </label>
        </div>
        {
          tags.length > 0 && (
            <fieldset class="tags" data-max={MAX_FILTER_TAGS}>
              <legend>{t('feed.tagsLabel')}</legend>
              <p class="hint" id="feed-tags-hint">{t('feed.tagsHint', { count: MAX_FILTER_TAGS })}</p>
              {/* No name: the box only narrows the list below, it is never sent. Shown once the script can work it. */}
              <input class="find" type="search" autocomplete="off" placeholder={t('feed.findTag')} aria-label={t('feed.findTag')} aria-controls="feed-tags" hidden />
              <ul id="feed-tags" class="tag-list" role="list" aria-describedby="feed-tags-hint">
                {tags.map(tag => (
                  <li>
                    <label>
                      <input type="checkbox" name="tag" value={tag} checked={chosen.includes(tag)} />
                      {tag}
                    </label>
                  </li>
                ))}
              </ul>
              <p class="none" role="status"></p>
            </fieldset>
          )
        }
        <div class="apply">
          <button type="submit" class="secondary">{t('feed.applyFilters')}</button>
          <p class="ai-note">{t('feed.labelsNote')}</p>
        </div>
      </div>
    </details>
  </div>
</form>

<script>
  import { t } from '../i18n/t';

  const more = document.querySelector<HTMLDetailsElement>('.search .more');
  const tags = more?.querySelector<HTMLFieldSetElement>('.tags');
  if (more) {
    // A dropdown: Esc or a click outside folds it away again.
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && more.open) {
        more.open = false;
        more.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', event => {
      if (more.open && !more.contains(event.target as Node)) more.open = false;
    });
  }
  if (tags) {
    const find = tags.querySelector<HTMLInputElement>('.find')!;
    const none = tags.querySelector<HTMLElement>('.none')!;
    const boxes = [...tags.querySelectorAll<HTMLInputElement>('input[name="tag"]')];
    const max = Number(tags.dataset.max);
    find.hidden = false;
    // Typing narrows the list; a chosen Tag stays in view whatever is typed, so it can always be unchosen.
    find.addEventListener('input', () => {
      const words = find.value.trim().toLowerCase();
      let shown = 0;
      for (const box of boxes) {
        const visible = !words || box.checked || box.value.includes(words);
        box.closest('li')!.hidden = !visible;
        if (visible) shown++;
      }
      none.textContent = shown === 0 ? t('feed.noTagMatch', { q: find.value.trim() }) : '';
    });
    // Enter in the box would send the form; here it only narrows.
    find.addEventListener('keydown', event => {
      if (event.key === 'Enter') event.preventDefault();
    });
    // At the most a feed can be filtered by, the rest wait until one is unchosen.
    const limit = () => {
      const full = boxes.filter(box => box.checked).length >= max;
      for (const box of boxes) box.disabled = full && !box.checked;
    };
    tags.addEventListener('change', limit);
    limit();
  }
</script>

<style>
  .search {
    position: relative;
  }
  /* One field: the words, then the magnifier and the filter icon inside its right end. */
  .bar {
    position: relative;
  }
  .bar input[type='search'] {
    min-height: 3rem;
    padding-inline: 0.9rem 5.75rem;
    border-color: var(--line);
    background: var(--surface);
    font-family: var(--font-serif);
    font-size: 1.125rem;
  }
  .bar > input::placeholder {
    color: var(--muted);
  }
  .bar > input:hover {
    border-color: var(--muted);
  }
  .go,
  .more summary {
    position: absolute;
    top: 0.25rem;
    display: inline-grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    min-height: 0;
    padding: 0;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: transparent;
    color: var(--green);
    cursor: pointer;
  }
  .go {
    right: 2.95rem;
  }
  .more summary {
    --knob: var(--surface);
    right: 0.25rem;
    list-style: none;
  }
  /* A hairline between the two icons: search, then refine. */
  .more summary::before {
    content: '';
    position: absolute;
    left: -0.2rem;
    top: 0.5rem;
    bottom: 0.5rem;
    border-left: 1px solid var(--line);
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .go:hover,
  .more summary:hover {
    background: var(--paper);
    --knob: var(--paper);
  }
  .more[open] summary {
    background: var(--green);
    color: var(--surface);
    --knob: var(--green);
  }
  .applied {
    position: absolute;
    top: -0.3rem;
    right: -0.3rem;
    display: inline-grid;
    place-items: center;
    min-width: 1.2rem;
    height: 1.2rem;
    padding-inline: 0.25rem;
    border-radius: 0.6rem;
    background: var(--brass);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1;
    box-shadow: 0 0 0 2px var(--surface);
  }
  /* A dropdown under the bar: it lies over the feed, and scrolls inside itself when it is taller than the window. */
  .panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    z-index: 2;
    display: grid;
    gap: 1rem 2rem;
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1rem;
    border: 1px solid var(--line);
    border-top: 3px solid var(--brass);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: 0 0.75rem 2rem -0.75rem rgb(10 25 18 / 0.35);
  }
  .fields {
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .panel label,
  .tags legend {
    font-size: 0.9rem;
  }
  .panel select {
    min-height: 2.75rem;
  }
  .tags {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .tags legend {
    padding: 0;
    font-weight: 600;
  }
  .tags > * + * {
    margin-top: 0.4rem;
  }
  .hint,
  .ai-note,
  .none {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .none:empty {
    display: none;
  }
  .find {
    min-height: 2.5rem;
    font-size: 0.95rem;
  }
  /* The Tags as toggles that wrap; the list scrolls once it is longer than a handful of rows. */
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.4rem;
    max-height: 11.5rem;
    margin: 0;
    padding: 0.1rem;
    overflow-y: auto;
    list-style: none;
  }
  .tag-list li[hidden] {
    display: none;
  }
  .tag-list label {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    min-height: 2.25rem;
    padding: 0.2rem 0.7rem 0.2rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 1.125rem;
    background: var(--paper);
    font-size: 0.9rem;
    line-height: 1.2;
    cursor: pointer;
  }
  .tag-list label:hover {
    border-color: var(--muted);
  }
  .tag-list input {
    width: 1rem;
    height: 1rem;
    min-height: 0;
    margin: 0;
    accent-color: var(--green);
  }
  .tag-list label:has(:checked) {
    border-color: var(--green);
    background: color-mix(in srgb, var(--green) 12%, var(--surface));
    font-weight: 600;
  }
  .tag-list label:has(:disabled) {
    color: var(--muted);
    cursor: not-allowed;
  }
  .tag-list label:has(:disabled):hover {
    border-color: var(--line);
  }
  .tag-list label:has(:focus-visible) {
    outline: 3px solid var(--focus);
    outline-offset: 1px;
  }
  .tag-list input:focus-visible {
    outline: 0;
  }
  .apply {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 40rem) {
    .panel {
      grid-template-columns: minmax(12rem, 1fr) minmax(0, 1.6fr);
      padding: 1.25rem;
    }
    .apply {
      grid-column: 1 / -1;
    }
  }
</style>
