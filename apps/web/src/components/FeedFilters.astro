---
// The feed's finding aids: one search bar (plain GET, so it works without JavaScript) with every filter folded away
// beside it under More filters, and below it the filters in force with a way to drop each.
import { t, tn } from '../i18n/t';
import { modelLabel, type ModelInfo } from '../lib/debate';
import { CATEGORIES, categoryLabel, feedHref, type FeedParams } from '../lib/feed';

interface Props {
  params: FeedParams;
  /** The models offered in the Debater filter. */
  models: ModelInfo[];
  /** Every model's name, to show a filtered model that is not offered. */
  allModels: ModelInfo[];
  popularTags: string[];
  total: number;
}

const { params, models, allModels, popularTags, total } = Astro.props;
const filtered = Object.keys(params).some(key => key !== 'page');
const offered = params.model && !models.some(m => m.id === params.model) ? [...models, { id: params.model, label: modelLabel(params.model, allModels) }] : models;
// A Tag reached from an entry may not be a popular one; it is still offered, so a search keeps it.
const tags = params.tag && !popularTags.includes(params.tag) ? [params.tag, ...popularTags] : popularTags;
const folded = [params.category, params.tag, params.model, params.kind].filter(Boolean).length;
const active = [
  ...(params.q ? [{ name: t('feed.filterSearch', { q: params.q }), change: { q: undefined } }] : []),
  ...(params.category ? [{ name: categoryLabel(params.category), change: { category: undefined } }] : []),
  ...(params.tag ? [{ name: params.tag, change: { tag: undefined } }] : []),
  ...(params.model ? [{ name: modelLabel(params.model, allModels), change: { model: undefined } }] : []),
  ...(params.kind ? [{ name: t(params.kind === 'batch' ? 'feed.filterSlow' : 'feed.filterLive'), change: { kind: undefined } }] : []),
];
---

<form class="search" role="search" method="get" action="/">
  <div class="bar">
    <label for="feed-q" class="visually-hidden">{t('feed.searchLabel')}</label>
    <input id="feed-q" type="search" name="q" value={params.q ?? ''} maxlength="100" autocomplete="off" placeholder={t('feed.searchPlaceholder')} />
    <button type="submit" aria-label={t('feed.search')}>
      <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
        <circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="2"></circle>
        <path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
      </svg>
    </button>
  </div>
  <details class="more">
    <summary>
      {t('feed.moreFilters')}
      {folded > 0 && <span class="applied">{folded}<span class="visually-hidden"> {t('feed.applied')}</span></span>}
    </summary>
    <div class="panel">
      <div class="field">
        <label for="feed-category">{t('feed.categoryLabel')}</label>
        <select id="feed-category" name="category">
          <option value="">{t('feed.anyCategory')}</option>
          {CATEGORIES.map(category => <option value={category} selected={params.category === category}>{categoryLabel(category)}</option>)}
        </select>
      </div>
      {
        tags.length > 0 && (
          <div class="field">
            <label for="feed-tag">{t('feed.tagLabel')}</label>
            <select id="feed-tag" name="tag">
              <option value="">{t('feed.anyTag')}</option>
              {tags.map(tag => <option value={tag} selected={params.tag === tag}>{tag}</option>)}
            </select>
          </div>
        )
      }
      <div class="field">
        <label for="feed-model">{t('feed.modelLabel')}</label>
        <select id="feed-model" name="model">
          <option value="">{t('feed.anyModel')}</option>
          {offered.map(m => <option value={m.id} selected={params.model === m.id}>{m.label}</option>)}
        </select>
      </div>
      <label class="choice">
        <input type="checkbox" name="kind" value="batch" checked={params.kind === 'batch'} />
        {t('feed.slowOnly')}
      </label>
      <div class="apply">
        <button type="submit" class="secondary">{t('feed.applyFilters')}</button>
        <p class="ai-note">{t('feed.labelsNote')}</p>
      </div>
    </div>
  </details>
</form>

{
  filtered && (
    <div class="found">
      <p class="count">{tn('feed.count', total)}</p>
      <ul class="active" role="list">
        {active.map(filter => (
          <li>
            <a href={feedHref(params, filter.change)} aria-label={t('feed.removeFilter', { name: filter.name })}>
              {filter.name}
              <span aria-hidden="true">×</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  /* One line: the search bar, and More filters set against its right end. The summary sits over the bar's row
     (absolutely), so the panel it opens unfolds in the flow below the whole line rather than over the feed. */
  .search {
    position: relative;
    margin-bottom: 1.25rem;
  }
  .bar {
    position: relative;
    margin-right: 9.5rem;
  }
  .bar input {
    min-height: 3rem;
    padding-inline: 0.9rem 3.25rem;
    border-color: var(--line);
    font-family: var(--font-serif);
    font-size: 1.125rem;
  }
  .bar input::placeholder {
    color: var(--muted);
  }
  .bar input:hover {
    border-color: var(--muted);
  }
  /* The magnifier sits inside the bar's right end: the bar reads as one field, not a field and a button. */
  .bar button {
    position: absolute;
    inset-block: 0.25rem;
    right: 0.25rem;
    min-height: 0;
    width: 2.5rem;
    padding: 0;
    border-color: transparent;
    background: transparent;
    color: var(--green);
  }
  .bar button:hover {
    background: var(--paper);
  }
  .more summary {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: center;
    width: 9rem;
    min-height: 3rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--green);
    font-size: 0.95rem;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }
  .more summary::-webkit-details-marker {
    display: none;
  }
  .more summary:hover {
    border-color: var(--muted);
  }
  .more[open] summary {
    border-color: var(--green);
    background: var(--surface);
  }
  .applied {
    display: inline-grid;
    place-items: center;
    min-width: 1.4rem;
    height: 1.4rem;
    padding-inline: 0.3rem;
    border-radius: 0.7rem;
    background: var(--green);
    color: var(--paper);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }
  .panel {
    display: grid;
    gap: 0.75rem 1.5rem;
    margin-top: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--line);
    border-top: 2px solid var(--brass);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .panel label {
    font-size: 0.9rem;
  }
  .panel select {
    min-height: 2.75rem;
  }
  .apply {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: center;
  }
  .ai-note {
    color: var(--muted);
    font-size: 0.85rem;
  }
  .found {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 1.25rem;
    margin-bottom: 1rem;
    font-size: 0.9rem;
  }
  .count {
    font-size: 1rem;
    font-weight: 600;
  }
  .active {
    display: flex;
    flex-wrap: wrap;
    gap: 0.1rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .active a {
    display: inline-flex;
    gap: 0.35rem;
    align-items: baseline;
    padding-block: 0.3rem;
    color: var(--ink);
    text-decoration-color: var(--line);
  }
  .active a span {
    color: var(--against);
    font-weight: 600;
  }
  /* On a phone the toggle keeps only its width's worth of words: the bar takes the rest. */
  @media (max-width: 39.99rem) {
    .bar {
      margin-right: 8.5rem;
    }
    .more summary {
      width: 8rem;
      font-size: 0.9rem;
    }
  }
  @media (min-width: 40rem) {
    .panel {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: end;
    }
    .apply {
      grid-column: 1 / -1;
    }
  }
</style>
