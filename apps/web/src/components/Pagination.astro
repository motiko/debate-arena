---
// Numbered pages for the feed: previous, the first, the current with its neighbours, the last, next. Plain links,
// so it works without JavaScript.
import { t } from '../i18n/t';
import { feedHref, pageList, type FeedParams } from '../lib/feed';

interface Props {
  params: FeedParams;
  page: number;
  pageCount: number;
}

const { params, page, pageCount } = Astro.props;
---

{
  pageCount > 1 && (
    <nav class="pages" aria-label={t('feed.pages')}>
      <p class="visually-hidden">{t('feed.pageOf', { page, count: pageCount })}</p>
      <ul role="list">
        {page > 1 && (
          <li>
            <a class="step" href={feedHref(params, { page: page - 1 })} rel="prev">
              {t('feed.previous')}
            </a>
          </li>
        )}
        {pageList(page, pageCount).map(n =>
          n === 'gap' ? (
            <li class="gap" aria-hidden="true">
              …
            </li>
          ) : (
            <li>
              <a
                class="number"
                href={feedHref(params, { page: n })}
                aria-label={t('feed.pageLabel', { page: n })}
                aria-current={n === page ? 'page' : undefined}
              >
                {n}
              </a>
            </li>
          ),
        )}
        {page < pageCount && (
          <li>
            <a class="step" href={feedHref(params, { page: page + 1 })} rel="next">
              {t('feed.next')}
            </a>
          </li>
        )}
      </ul>
    </nav>
  )
}

<style>
  .pages ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pages a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.75rem;
    min-height: 2.75rem;
    padding-inline: 0.5rem;
    color: var(--green);
    text-decoration: none;
    border-radius: var(--radius);
  }
  .pages a:hover {
    text-decoration: underline;
  }
  /* Page numbers are the house's serif numerals; the page you are on is set in brass, underlined like the rule. */
  .number {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .pages .number[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline 2px var(--brass);
    text-underline-offset: 0.3em;
  }
  .step {
    font-weight: 600;
  }
  .gap {
    color: var(--muted);
    padding-inline: 0.25rem;
  }
</style>
