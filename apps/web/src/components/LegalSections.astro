---
import type { LegalSection } from '../legal/content';

interface Props {
  sections: LegalSection[];
}

const { sections } = Astro.props;
---

{
  sections.map(section => (
    <section class="stack">
      <h2>{section.heading}</h2>
      {section.paragraphs.map(p => (
        <p>{p}</p>
      ))}
    </section>
  ))
}
