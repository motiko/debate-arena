---
// Everything under the floor that depends on how the Debate ended: the after-vote when it is due, then the
// Verdict, the Audience Result and any AI Audience Result. They follow the hybrid rule (outcomeHidden): open,
// or folded together in one <details id="outcome"> that the dispatch box's "Show the result" also opens.
// data-region: when a live Debate ends, or after the after-vote, the page swaps in a fresh render (lib/refresh).
import type { PublicDebate } from '@debate-arena/api-client';
import AudienceResultView from './AudienceResultView.astro';
import VerdictView from './VerdictView.astro';
import VotePanel from '../islands/VotePanel.svelte';
import { t } from '../i18n/t';
import { dispatchState, outcomeHidden, voterModels, type ModelInfo } from '../lib/debate';
import { formatDate } from '../lib/format';

interface Props {
  debate: PublicDebate;
  models: ModelInfo[];
  signedIn: boolean;
}

const { debate, models, signedIn } = Astro.props;
const isBatch = debate.kind === 'batch';
const closesAt = debate.audienceResult.votingClosesAt;
const askAfter = dispatchState(debate) === 'askAfter';
const hidden = outcomeHidden({ ...debate, votingClosesAt: closesAt });
const Wrapper = hidden ? 'details' : 'div';
const membersPanel = !isBatch && debate.status !== 'failed';
---

<div class="outcome-region" data-region="outcome">
  {
    !debate.turnsHidden && (
      <>
        {debate.status === 'running' && !isBatch && (
          <div class="pending">
            <p>{debate.myVote?.before ? t('live.pendingVoter') : t('verdict.pending')}</p>
            <noscript>
              <p>{t('live.noscript')}</p>
            </noscript>
          </div>
        )}

        {askAfter && (
          <section id="after-vote" class="after-vote" aria-label={t('vote.title')}>
            <VotePanel
              client:load
              only="after"
              debateId={debate.id}
              motion={debate.motion}
              status={debate.status}
              myVote={debate.myVote}
              signedIn={signedIn}
              turnsHidden={debate.turnsHidden}
              votingClosesAt={closesAt}
            />
          </section>
        )}

        {debate.verdict && debate.status !== 'running' && (
          <>
            {/* Why it is folded is said once: by the dispatch box, unless that box is busy asking for the after-vote. */}
            {hidden && closesAt && <p class="fold-note">{t(askAfter ? 'outcome.folded' : 'outcome.foldedUntil', { date: formatDate(closesAt) })}</p>}
            <Wrapper id="outcome" class={hidden ? 'outcome fold' : 'outcome'}>
              {hidden && (
                <summary>
                  <span class="when-closed">{t('dispatch.show')}</span>
                  <span class="when-open">{t('dispatch.hide')}</span>
                </summary>
              )}
              <VerdictView verdict={debate.verdict} debaters={debate.debaters} motion={debate.motion} selfJudging={debate.selfJudging} models={models} />
              {/* The two audiences side by side, in the same panel; a Slow Debate has only the AI one. */}
              <div class="audiences">
                {membersPanel && (
                  <AudienceResultView title={t('audience.title')} result={debate.audienceResult} voters="members" myVote={debate.myVote} explainSwing />
                )}
                {debate.aiAudience && (
                  <AudienceResultView
                    title={t('aiAudience.title')}
                    ai
                    result={debate.aiAudience}
                    voters="aiVoters"
                    explainSwing={!membersPanel}
                    notes={[
                      t('aiAudience.voters', { models: voterModels(debate.aiVoters, models) }),
                      ...(debate.aiAudience.dropped.length > 0 ? [t('aiAudience.dropped', { count: debate.aiAudience.dropped.length })] : []),
                    ]}
                    warning={debate.aiVotersShareDebaterModel ? t('aiAudience.shared') : undefined}
                  />
                )}
              </div>
            </Wrapper>
          </>
        )}
      </>
    )
  }
</div>

<style>
  .pending {
    max-width: 44rem;
    margin: calc(var(--space) * 2) auto 0;
    color: var(--muted);
    text-align: center;
  }
  /* The after-vote closes the floor: the Oxford question asked again, under a brass rule, where the reading ends. */
  .after-vote {
    max-width: 26rem;
    margin: calc(var(--space) * 2.5) auto 0;
    padding-top: 1.5rem;
    border-top: 2px solid var(--brass);
  }
  .after-vote :global(fieldset) {
    border: 0;
    border-radius: 0;
    padding: 0;
  }
  .after-vote :global(legend) {
    width: 100%;
    margin-bottom: 0.5rem;
    padding: 0;
    font-family: var(--font-serif);
    font-size: clamp(1.45rem, 1.2rem + 1vw, 1.85rem);
    text-align: center;
  }
  .after-vote :global(.was) {
    margin-bottom: 0.5rem;
    text-align: center;
  }
  .after-vote :global(button[type='submit']) {
    width: 100%;
  }
  .fold-note {
    max-width: 36rem;
    margin: calc(var(--space) * 2.5) auto 0;
    color: var(--muted);
    text-align: center;
  }
  .fold {
    margin-top: 0.75rem;
  }
  .fold summary {
    display: flex;
    width: fit-content;
    align-items: center;
    min-height: 2.75rem;
    margin-inline: auto;
    padding: 0.4rem 1.1rem;
    border: 1.5px solid var(--green);
    border-radius: var(--radius);
    color: var(--green);
    font-weight: 600;
    cursor: pointer;
  }
  /* The summary stays put when open (keyboard focus stays on it) and offers to hide the result again. */
  .fold summary .when-open,
  .fold[open] summary .when-closed {
    display: none;
  }
  .fold[open] summary .when-open {
    display: inline;
  }
  /* One column on a narrow screen; two equal panels once both fit. A lone panel keeps the reading width. */
  .audiences {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: calc(var(--space) * 2);
    max-width: 60rem;
    margin: calc(var(--space) * 2.5) auto 0;
  }
  .audiences:has(> :only-child) {
    max-width: 44rem;
  }
  .audiences:empty {
    display: none;
  }
  /* When the Debate ends (or the after-vote is cast) the fresh outcome settles in once. */
  @media (prefers-reduced-motion: no-preference) {
    .outcome-region[data-arrived] {
      animation: arrive 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
  }
  @keyframes arrive {
    from {
      opacity: 0.35;
      transform: translateY(0.75rem);
    }
  }
</style>
