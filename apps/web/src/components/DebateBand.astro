---
// The top of a Debate page, inside the bench-green band: the Motion, the two benches and between them the
// dispatch box, which asks the reader first and shows the outcome by the hybrid rule (spec: Band).
// data-region: when a live Debate ends, or after the after-vote, the page swaps in a fresh render of the
// benches (lib/refresh); data-announce is what that swap says to screen readers.
import type { PublicDebate } from '@debate-arena/api-client';
import BatchBadge from './BatchBadge.astro';
import OutcomeSummary from './OutcomeSummary.astro';
import SignInButton from '../islands/SignInButton.svelte';
import VotePanel from '../islands/VotePanel.svelte';
import { t } from '../i18n/t';
import { debaterLabel, dispatchState, motionSize, outcome, sideLabel, spokeCount, type ModelInfo } from '../lib/debate';

interface Props {
  debate: PublicDebate;
  models: ModelInfo[];
  signedIn: boolean;
}

const { debate, models, signedIn } = Astro.props;
const state = dispatchState(debate);
const result = outcome(debate, models);
const benches = (['for', 'against'] as const).map(side => ({
  side,
  title: t(side === 'for' ? 'band.forBench' : 'band.againstBench'),
  model: debaterLabel(debate.debaters[side], models),
  spoke: spokeCount(debate.turns, side),
}));
const before = debate.myVote?.before;
// One sign-in on the page, with its reason, while there is still something to vote on.
const askSignIn = !signedIn && (state === 'live' || state === 'hidden');
const announce =
  state === 'askAfter' ? t('end.askAfter') : state === 'hidden' ? t('end.folded') : state === 'revealed' && result ? `${result.headline}.` : '';
---

<div class="debate-band">
  <p class="band-label">{t('band.motion')} {debate.kind === 'batch' && <BatchBadge />}</p>
  <h1 class={`motion motion-${motionSize(debate.motion)}`}>{debate.motion}</h1>

  <div class="benches" data-region="benches" data-announce={announce}>
    {
      benches.map(bench => (
        <div class={`bench bench-${bench.side}`}>
          <p class="bench-title">{bench.title}</p>
          <p class="bench-model">{bench.model}</p>
          {bench.spoke > 0 && <p class="bench-spoke">{bench.spoke === 1 ? t('band.spokeOnce') : t('band.spoke', { count: bench.spoke })}</p>}
        </div>
      ))
    }
    <div class="dispatch">
      {
        state === 'ask' ? (
          <>
            {debate.status === 'running' && (
              <p class="dispatch-status">
                <span class="live-dot" aria-hidden="true" />
                {t('dispatch.live')}
              </p>
            )}
            <VotePanel
              client:load
              only="before"
              debateId={debate.id}
              motion={debate.motion}
              status={debate.status}
              myVote={debate.myVote}
              signedIn={signedIn}
              turnsHidden={debate.turnsHidden}
              votingClosesAt={debate.audienceResult.votingClosesAt}
            />
          </>
        ) : state === 'generating' ? (
          <p>{t('dispatch.generating')}</p>
        ) : state === 'live' ? (
          <>
            <p class="dispatch-title">
              <span class="live-dot" aria-hidden="true" />
              {t('dispatch.live')}
            </p>
            <p>{t('dispatch.follow')}</p>
          </>
        ) : state === 'audienceFailed' ? (
          <p>{t('dispatch.audienceFailed')}</p>
        ) : state === 'judgingFailed' ? (
          <p>{t('dispatch.judgingFailed')}</p>
        ) : state === 'failed' ? (
          <p>{t('debate.failed')}</p>
        ) : !result ? (
          <p>{t('verdict.pending')}</p>
        ) : state === 'revealed' ? (
          <OutcomeSummary outcome={result} />
        ) : (
          <>
            {/* Folded: one reveal for the whole page. The link opens <details id="outcome"> under the floor
                (without JavaScript it jumps there, to its "Show the result"); while that is open this box
                shows the outcome too (CSS :has). */}
            <div class="folded">
              <p class="dispatch-title">{t('dispatch.votingOpen')}</p>
              {state === 'askAfter' && before ? (
                <>
                  <p>{t('vote.youBefore', { stance: before === 'undecided' ? t('vote.undecided') : sideLabel(before) })}</p>
                  <p>{t('dispatch.voteAgain')}</p>
                  <p class="dispatch-action">
                    <a href="#after-vote">{t('dispatch.toAfterVote')}</a>
                  </p>
                </>
              ) : (
                <>
                  <p>{t('dispatch.folded')}</p>
                  <p class="dispatch-action">
                    <a href="#outcome" data-reveal>
                      {t('dispatch.show')}
                    </a>
                  </p>
                </>
              )}
            </div>
            <div class="unfolded">
              <OutcomeSummary outcome={result} />
            </div>
          </>
        )
      }
      {
        askSignIn && (
          <div class="sign-in">
            <p>{t('dispatch.signIn')}</p>
            <SignInButton client:idle callbackPath={`/debates/${debate.id}`} label={t('dispatch.signInButton')} />
          </div>
        )
      }
    </div>
  </div>
</div>

<script>
  // "Show the result" in the dispatch box opens the one folded outcome under the floor, then the link jumps
  // there. Delegated, so it keeps working after the benches are swapped in fresh (lib/refresh).
  document.addEventListener('click', event => {
    const link = event.target instanceof Element ? event.target.closest('a[data-reveal]') : null;
    const fold = document.getElementById('outcome');
    if (!link || !(fold instanceof HTMLDetailsElement)) return;
    fold.open = true;
    fold.querySelector('summary')?.focus({ preventScroll: true });
  });
</script>

<style>
  .debate-band {
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
  .band-label {
    color: var(--band-muted);
    font-size: 0.95rem;
  }
  .band-label :global(.badge) {
    color: var(--band-ink);
  }
  .motion {
    margin-top: 0.75rem;
    max-width: 60rem;
    line-height: 1.1;
    letter-spacing: -0.015em;
    overflow-wrap: anywhere;
  }
  .motion-l {
    font-size: clamp(2.0625rem, 1.2rem + 3.6vw, 3.75rem);
  }
  .motion-m {
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 2.75rem);
  }
  .motion-s {
    font-size: clamp(1.5rem, 1.1rem + 1.8vw, 2.25rem);
  }

  /* Phone: the dispatch box first, the two benches side by side under it. */
  .benches {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-areas: 'dispatch dispatch' 'for against';
    gap: 0 0.375rem;
    margin-top: 1.75rem;
  }
  .bench {
    padding: 0.9rem 1rem 1rem;
    color: var(--on-fill);
  }
  .bench-for {
    grid-area: for;
    background: var(--for-fill);
  }
  .bench-against {
    grid-area: against;
    background: var(--against-fill);
    text-align: right;
  }
  .bench-title {
    font-size: 0.85rem;
    font-weight: 600;
  }
  .bench-model {
    margin-top: 0.15rem;
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 0.9rem + 1.2vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
  }
  .bench-spoke {
    margin-top: 0.4rem;
    font-size: 0.85rem;
  }
  .dispatch {
    --focus: var(--ink);
    grid-area: dispatch;
    margin-bottom: 0.375rem;
    padding: 1rem 1.1rem 1.1rem;
    border: 2px solid var(--brass);
    border-radius: var(--radius);
    background: var(--paper);
    color: var(--ink);
    text-align: center;
  }
  .dispatch :global(a) {
    color: var(--green);
    font-weight: 600;
  }
  .dispatch :global(.vote) {
    text-align: left;
  }
  /* The before-vote's legend is the box's one question: no inner border, no second card inside the box. */
  .dispatch :global(fieldset) {
    border: 0;
    border-radius: 0;
    padding: 0;
  }
  .dispatch :global(legend),
  .dispatch-title {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.2;
  }
  .dispatch :global(legend) {
    width: 100%;
    margin-bottom: 0.35rem;
    padding: 0;
    text-align: center;
  }
  .dispatch-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }
  .dispatch-status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    margin-bottom: 0.6rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9rem;
    font-weight: 600;
  }
  .dispatch p + p,
  .folded > * + * {
    margin-top: 0.35rem;
  }
  .dispatch-action {
    display: flex;
    justify-content: center;
  }
  .dispatch-action a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }
  /* One reveal for the page: while the folded outcome under the floor is open, this box shows it too. */
  .unfolded {
    display: none;
  }
  :global(body:has(#outcome[open])) .unfolded {
    display: block;
  }
  :global(body:has(#outcome[open])) .folded {
    display: none;
  }
  .sign-in {
    margin-top: 0.85rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--line);
  }
  .sign-in p {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }
  /* Wide: the benches flank the dispatch box, which stands taller than both. */
  @media (min-width: 48rem) {
    .benches {
      grid-template-columns: minmax(0, 1fr) 15rem minmax(0, 1fr);
      grid-template-areas: 'for dispatch against';
      align-items: end;
      gap: 0 1.25rem;
      margin-top: 3rem;
    }
    .bench {
      margin-top: 1.5rem;
      padding: 1.25rem 1.5rem 1.4rem;
      border-radius: var(--radius) var(--radius) 0 0;
    }
    .dispatch {
      align-self: stretch;
      display: flex;
      flex-direction: column;
      justify-content: center;
      margin-bottom: 0;
      border-bottom: 0;
      border-radius: var(--radius) var(--radius) 0 0;
    }
  }
</style>
