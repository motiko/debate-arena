---
import type { PublicDebate } from '@debate-arena/api-client';
import SwingChart from './SwingChart.astro';
import { t } from '../i18n/t';
import { swingText } from '../lib/debate';
import { formatDate } from '../lib/format';

interface Props {
  result: PublicDebate['audienceResult'];
}

const { result } = Astro.props;
const closesAt = result.votingClosesAt;
const closed = closesAt !== null && Date.parse(closesAt) <= Date.now();
---

<section class="division stack" aria-labelledby="audience-title">
  <h2 id="audience-title">{t('audience.title')}</h2>
  <slot name="vote" />
  <SwingChart result={result} label={swingText(result)} />
  {
    closesAt && (
      <p class="muted">
        <time datetime={closesAt}>{t(closed ? 'audience.closed' : 'audience.closes', { date: formatDate(closesAt) })}</time>
      </p>
    )
  }
</section>

<style>
  .division {
    max-width: 44rem;
    margin-inline: auto;
  }
</style>
