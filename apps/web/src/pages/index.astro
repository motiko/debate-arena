---
import AiLabel from '../components/AiLabel.astro';
import BatchBadge from '../components/BatchBadge.astro';
import SelfJudgingBadge from '../components/SelfJudgingBadge.astro';
import Base from '../layouts/Base.astro';
import { t } from '../i18n/t';
import { debaterLabel, FEED_PAGE_SIZE, feedOutcome, nextFeedCursor, type ModelInfo } from '../lib/debate';
import { formatDate } from '../lib/format';

const { api } = Astro.locals;
const beforeParam = Astro.url.searchParams.get('before');
// Only a real date is passed on as the cursor; anything else shows the first page.
const before = beforeParam && !Number.isNaN(Date.parse(beforeParam)) ? beforeParam : undefined;

const [feedRes, modelsRes] = await Promise.all([
  api.api.debates.$get({ query: before ? { before } : {} }),
  api.api.models.$get(),
]);
if (!feedRes.ok) throw new Error(`GET /api/debates failed (${feedRes.status})`);
const { debates } = await feedRes.json();
const models: ModelInfo[] = modelsRes.ok ? (await modelsRes.json()).models : [];
const cursor = nextFeedCursor(debates, FEED_PAGE_SIZE);
---

<Base title={t('feed.title')} description={t('feed.description')} canonicalPath={before ? `/?before=${encodeURIComponent(before)}` : '/'} wide>
  <div class="feed-head">
    <h1>{t('feed.title')}</h1>
    <p class="muted">{t('site.tagline')}</p>
  </div>
  {
    debates.length === 0 ? (
      <div class="empty stack">
        <p>{t('feed.empty')}</p>
        <p>
          <a href="/new">{t('feed.startFirst')}</a>
        </p>
      </div>
    ) : (
      <ol class="order-paper" role="list">
        {debates.map(d => (
          <li class="entry">
            <h2 class="entry-motion">
              <a href={`/debates/${d.id}`}>{d.motion}</a>
            </h2>
            <p class="entry-sides">
              {t('feed.sides', { for: debaterLabel(d.debaters.for, models), against: debaterLabel(d.debaters.against, models) })}
            </p>
            <div class="entry-notes">
              <p class="entry-meta">
                {d.verdict && feedOutcome(d) === 'votingOpen' ? (
                  <strong>
                    {/* The date is kept on one line: the narrow outcome gutter would otherwise break it after the month. */}
                    {d.votingClosesAt ? t('feed.votingOpenUntil', { date: formatDate(d.votingClosesAt).replaceAll(' ', ' ') }) : t('feed.votingOpen')}
                  </strong>
                ) : (
                  d.verdict && (
                    <>
                      <strong class={`side-${d.verdict.winner}`}>{t(d.verdict.winner === 'for' ? 'feed.carried' : 'feed.defeated')}</strong>
                      <AiLabel />
                      {d.selfJudging && <SelfJudgingBadge />}
                    </>
                  )
                )}
              </p>
              {d.kind === 'batch' && <p class="entry-batch"><BatchBadge /></p>}
            </div>
            {d.completedAt && <p class="entry-date"><time datetime={d.completedAt}>{formatDate(d.completedAt)}</time></p>}
          </li>
        ))}
      </ol>
    )
  }
  {
    cursor && (
      <p class="older">
        <a class="button secondary" href={`/?before=${encodeURIComponent(cursor)}`}>{t('feed.older')}</a>
      </p>
    )
  }
</Base>

<style>
  /* The order paper. Phone: one column, the outcome and the date on the last line of each entry. Desktop: the
     same entries in three columns, the date in the left margin and the outcome in a right gutter of margin notes,
     the Motion at a reading measure between them. No numbering: the feed pages by date, so a list position would
     mean nothing and restart on every page. */
  .order-paper {
    list-style: none;
    padding: 0;
  }
  .entry {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas:
      'motion motion'
      'sides sides'
      'notes date';
    align-items: baseline;
    gap: 0 1rem;
    padding-block: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .entry:last-child {
    border-bottom: 1px solid var(--line);
  }
  .entry-motion {
    grid-area: motion;
    font-size: 1.375rem;
    line-height: 1.25;
  }
  .entry-motion a {
    color: var(--ink);
    text-decoration-color: var(--line);
  }
  .entry-motion a:hover {
    text-decoration-color: currentColor;
  }
  .entry-sides {
    grid-area: sides;
    margin-top: 0.35rem;
  }
  .entry-notes {
    grid-area: notes;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
  }
  .entry-meta:empty,
  .entry-notes:has(> .entry-meta:empty):not(:has(> .entry-batch)) {
    display: none;
  }
  /* The outcome comes from the AI Verdict, so it keeps its AI-generated label (ADR 0005), but as a quiet
     note beside the word rather than a pill repeated down the page. */
  .entry-meta :global(.badge:not(.badge-warn)) {
    padding: 0;
    border: 0;
    font-weight: 400;
    font-size: 0.85rem;
  }
  .entry-date {
    grid-area: date;
    color: var(--muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .empty {
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }
  @media (min-width: 64rem) {
    .feed-head,
    .empty,
    .older {
      margin-inline-start: calc(8rem + 2.5rem);
      max-width: 46rem;
    }
    .entry {
      grid-template-columns: 8rem minmax(0, 46rem) minmax(11rem, 1fr);
      grid-template-areas:
        'date motion notes'
        'date sides notes';
      align-items: start;
      column-gap: 2.5rem;
      padding-block: 1.4rem;
    }
    .entry-date {
      padding-top: 0.3rem;
      font-family: var(--font-serif);
      font-size: 1rem;
    }
    .entry-notes {
      flex-direction: column;
      align-items: flex-start;
      margin-top: 0;
      padding-top: 0.3rem;
      padding-left: 1.25rem;
      border-left: 1px solid var(--line);
    }
  }
</style>
