---
import AiLabel from '../components/AiLabel.astro';
import BatchBadge from '../components/BatchBadge.astro';
import SelfJudgingBadge from '../components/SelfJudgingBadge.astro';
import Base from '../layouts/Base.astro';
import { t } from '../i18n/t';
import { debaterLabel, FEED_PAGE_SIZE, nextFeedCursor, type ModelInfo } from '../lib/debate';
import { formatDate } from '../lib/format';

const { api } = Astro.locals;
const beforeParam = Astro.url.searchParams.get('before');
// Only a real date is passed on as the cursor; anything else shows the first page.
const before = beforeParam && !Number.isNaN(Date.parse(beforeParam)) ? beforeParam : undefined;

const [feedRes, modelsRes] = await Promise.all([
  api.api.debates.$get({ query: before ? { before } : {} }),
  api.api.models.$get(),
]);
if (!feedRes.ok) throw new Error(`GET /api/debates failed (${feedRes.status})`);
const { debates } = await feedRes.json();
const models: ModelInfo[] = modelsRes.ok ? (await modelsRes.json()).models : [];
const cursor = nextFeedCursor(debates, FEED_PAGE_SIZE);
---

<Base title={t('feed.title')} description={t('feed.description')} canonicalPath={before ? `/?before=${encodeURIComponent(before)}` : '/'}>
  <h1>{t('feed.title')}</h1>
  <p class="muted">{t('site.tagline')}</p>
  {
    debates.length === 0 ? (
      <div class="empty stack">
        <p>{t('feed.empty')}</p>
        <p>
          <a href="/new">{t('feed.startFirst')}</a>
        </p>
      </div>
    ) : (
      <ol class="order-paper" role="list">
        {debates.map(d => (
          <li class="entry">
            <h2 class="entry-motion">
              <a href={`/debates/${d.id}`}>{d.motion}</a>
            </h2>
            <p class="entry-sides">
              {t('feed.sides', { for: debaterLabel(d.debaters.for, models), against: debaterLabel(d.debaters.against, models) })}{' '}
              {d.kind === 'batch' && <BatchBadge />}
            </p>
            <p class="entry-meta">
              {d.verdict && (
                <>
                  <strong class={`side-${d.verdict.winner}`}>{t(d.verdict.winner === 'for' ? 'feed.carried' : 'feed.defeated')}</strong>
                  <AiLabel />
                  {d.selfJudging && <SelfJudgingBadge />}
                </>
              )}
              {d.completedAt && <time datetime={d.completedAt}>{formatDate(d.completedAt)}</time>}
            </p>
          </li>
        ))}
      </ol>
    )
  }
  {
    cursor && (
      <p>
        <a href={`/?before=${encodeURIComponent(cursor)}`}>{t('feed.older')}</a>
      </p>
    )
  }
</Base>

<style>
  .order-paper {
    list-style: none;
    padding: 0;
    counter-reset: motion;
  }
  .entry {
    counter-increment: motion;
    position: relative;
    padding: 1.1rem 0 1.1rem 2.75rem;
    border-top: 1px solid var(--line);
  }
  .entry:last-child {
    border-bottom: 1px solid var(--line);
  }
  /* The order paper's numbering in the margin; a visual aid only (the list is already ordered). */
  .entry::before {
    content: counter(motion);
    position: absolute;
    left: 0;
    top: 1.15rem;
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: var(--muted);
  }
  .entry-motion {
    font-size: 1.375rem;
    line-height: 1.25;
  }
  .entry-motion a {
    color: var(--ink);
    text-decoration-color: var(--line);
  }
  .entry-motion a:hover {
    text-decoration-color: currentColor;
  }
  .entry-sides {
    margin-top: 0.35rem;
  }
  .entry-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.6rem;
    margin-top: 0.3rem;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .empty {
    padding-block: 1rem;
    border-top: 1px solid var(--line);
  }
</style>
