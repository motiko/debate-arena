---
import AiLabel from '../../components/AiLabel.astro';
import AudienceResultView from '../../components/AudienceResultView.astro';
import DebateBand from '../../components/DebateBand.astro';
import DebateRecord from '../../components/DebateRecord.astro';
import SwingChart from '../../components/SwingChart.astro';
import VerdictView from '../../components/VerdictView.astro';
import LiveTurns from '../../islands/LiveTurns.svelte';
import PhaseFloor from '../../islands/PhaseFloor.svelte';
import VotePanel from '../../islands/VotePanel.svelte';
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/t';
import { debaterLabel, modelLabel, swingText, type ModelInfo } from '../../lib/debate';

const { api, me } = Astro.locals;
const id = Astro.params.id ?? '';

const [debateRes, modelsRes] = await Promise.all([api.api.debates[':id'].$get({ param: { id } }), api.api.models.$get()]);
if (debateRes.status === 404) return Astro.rewrite('/404');
if (debateRes.status === 410) return Astro.rewrite(`/blocked/${encodeURIComponent(id)}`);
if (!debateRes.ok) throw new Error(`GET /api/debates/${id} failed (${debateRes.status})`);
const debate = await debateRes.json();
const models: ModelInfo[] = modelsRes.ok ? (await modelsRes.json()).models : [];

const debater = (side: 'for' | 'against') => debaterLabel(debate.debaters[side], models);
const speakers = { for: debater('for'), against: debater('against') };
const isBatch = debate.kind === 'batch';
---

<Base title={debate.motion} description={t('debate.description', { motion: debate.motion })} canonicalPath={`/debates/${debate.id}`} wide>
  <DebateBand slot="band" debate={debate} models={models} signedIn={me !== null} />

  {debate.visibility === 'unlisted' && debate.mine && <p class="note">{t('unlisted.mine')}</p>}
  {isBatch && debate.status === 'running' && <p class="note" role="status">{t('batch.generating')}</p>}
  {isBatch && debate.status === 'complete' && <p class="muted">{t('batch.noVotes')}</p>}

  <section aria-label={t('debate.turns')}>
    {
      debate.turnsHidden ? (
        <p class="note">{t('debate.turnsHidden')}</p>
      ) : debate.status === 'running' && !isBatch ? (
        <LiveTurns client:load debateId={debate.id} format={debate.format} speakers={speakers} initialTurns={debate.turns} />
      ) : debate.turns.length === 0 ? (
        <p class="muted">{t('debate.noTurns')}</p>
      ) : (
        <PhaseFloor format={debate.format} turns={debate.turns} speakers={speakers} />
      )
    }
  </section>

  {
    !debate.turnsHidden && (
      <>
        {debate.verdict ? (
          <VerdictView verdict={debate.verdict} debaters={debate.debaters} selfJudging={debate.selfJudging} models={models} />
        ) : (
          debate.status === 'running' && <p class="muted">{t('verdict.pending')}</p>
        )}

        {!isBatch && debate.status !== 'failed' && (
          <>
            <AudienceResultView result={debate.audienceResult}>
              <VotePanel
                slot="vote"
                client:load
                only="after"
                debateId={debate.id}
                motion={debate.motion}
                status={debate.status}
                myVote={debate.myVote}
                signedIn={me !== null}
                turnsHidden={debate.turnsHidden}
                votingClosesAt={debate.audienceResult.votingClosesAt}
              />
            </AudienceResultView>
          </>
        )}

        {debate.aiAudience && (
          <section class="ai-audience stack" aria-labelledby="ai-audience-title">
            <h2 id="ai-audience-title">
              {t('aiAudience.title')} <AiLabel />
            </h2>
            <SwingChart result={debate.aiAudience} label={swingText(debate.aiAudience, 'aiVoters')} />
            <p class="muted">{t('aiAudience.voters', { models: debate.aiVoters.map(m => modelLabel(m, models)).join(', ') })}</p>
            {debate.aiVotersShareDebaterModel && <p class="note">{t('aiAudience.shared')}</p>}
            {debate.aiAudience.dropped.length > 0 && <p class="muted">{t('aiAudience.dropped', { count: debate.aiAudience.dropped.length })}</p>}
          </section>
        )}
      </>
    )
  }

  <DebateRecord debate={debate} models={models} signedIn={me !== null} />
</Base>

<style>
  .ai-audience {
    max-width: 44rem;
    margin: calc(var(--space) * 2.5) auto 0;
  }
</style>
