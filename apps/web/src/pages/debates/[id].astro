---
import AiLabel from '../../components/AiLabel.astro';
import AudienceResultView from '../../components/AudienceResultView.astro';
import VerdictView from '../../components/VerdictView.astro';
import TurnItem from '../../islands/TurnItem.svelte';
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/t';
import { groupByPhase, modelLabel, swingText, turnHeading, type ModelInfo } from '../../lib/debate';
import { formatDate } from '../../lib/format';

const { api } = Astro.locals;
const id = Astro.params.id ?? '';

const [debateRes, modelsRes] = await Promise.all([api.api.debates[':id'].$get({ param: { id } }), api.api.models.$get()]);
if (debateRes.status === 404) return Astro.rewrite('/404');
if (!debateRes.ok) throw new Error(`GET /api/debates/${id} failed (${debateRes.status})`);
const debate = await debateRes.json();
const models: ModelInfo[] = modelsRes.ok ? (await modelsRes.json()).models : [];

const debater = (side: 'for' | 'against') => {
  const d = debate.debaters[side];
  return d.kind === 'ai' ? modelLabel(d.model, models) : d.memberId;
};
const groups = groupByPhase(debate.format, debate.turns);
---

<Base title={debate.motion} description={t('debate.description', { motion: debate.motion })} canonicalPath={`/debates/${debate.id}`}>
  <header class="stack">
    <p class="muted">{t('debate.motion')}</p>
    <h1>{debate.motion}</h1>
    <ul class="meta" role="list">
      <li><span class="side-for">{t('debate.debaterFor', { model: debater('for') })}</span></li>
      <li><span class="side-against">{t('debate.debaterAgainst', { model: debater('against') })}</span></li>
      <li class="muted">{t('debate.format', { name: debate.format.name })}</li>
      <li class="muted">
        {debate.status === 'running' && <strong>{t('debate.live')}</strong>}
        {
          debate.status === 'complete' && debate.completedAt && (
            <time datetime={debate.completedAt}>{t('debate.finished', { date: formatDate(debate.completedAt) })}</time>
          )
        }
      </li>
    </ul>
  </header>

  {debate.status === 'failed' && <p class="note" role="status">{t('debate.failed')}</p>}

  <section class="stack" aria-labelledby="turns-title">
    <h2 id="turns-title">{t('debate.turns')}</h2>
    {
      debate.turnsHidden ? (
        <p class="note">{t('debate.turnsHidden')}</p>
      ) : groups.length === 0 ? (
        <p class="muted">{t('debate.noTurns')}</p>
      ) : (
        groups.map(group => (
          <div class="stack">
            {group.turns.map(turn => (
              <TurnItem heading={turnHeading(debate.format, turn)} text={turn.text} truncated={turn.truncated} side={turn.side} />
            ))}
          </div>
        ))
      )
    }
  </section>

  {
    debate.verdict ? (
      <VerdictView verdict={debate.verdict} selfJudging={debate.selfJudging} models={models} />
    ) : (
      debate.status === 'running' && <p class="muted">{t('verdict.pending')}</p>
    )
  }

  {debate.status !== 'failed' && <AudienceResultView result={debate.audienceResult} />}

  {
    debate.aiAudience && (
      <section class="card stack" aria-labelledby="ai-audience-title">
        <h2 id="ai-audience-title">
          {t('aiAudience.title')} <AiLabel />
        </h2>
        <p>{swingText(debate.aiAudience, 'aiVoters')}</p>
        <p class="muted">{t('aiAudience.voters', { models: debate.aiVoters.map(m => modelLabel(m, models)).join(', ') })}</p>
        {debate.aiVotersShareDebaterModel && <p class="note">{t('aiAudience.shared')}</p>}
        {debate.aiAudience.dropped.length > 0 && <p class="muted">{t('aiAudience.dropped', { count: debate.aiAudience.dropped.length })}</p>}
      </section>
    )
  }
</Base>

<style>
  .meta {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
  }
</style>
