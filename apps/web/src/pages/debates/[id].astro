---
import DebateBand from '../../components/DebateBand.astro';
import DebateOutcome from '../../components/DebateOutcome.astro';
import DebateRecord from '../../components/DebateRecord.astro';
import LiveTurns from '../../islands/LiveTurns.svelte';
import PhaseFloor from '../../islands/PhaseFloor.svelte';
import Base from '../../layouts/Base.astro';
import { t } from '../../i18n/t';
import { debaterLabel, type ModelInfo } from '../../lib/debate';

const { api, me } = Astro.locals;
const id = Astro.params.id ?? '';

const [debateRes, modelsRes] = await Promise.all([api.api.debates[':id'].$get({ param: { id } }), api.api.models.$get()]);
if (debateRes.status === 404) return Astro.rewrite('/404');
if (debateRes.status === 410) return Astro.rewrite(`/blocked/${encodeURIComponent(id)}`);
if (!debateRes.ok) throw new Error(`GET /api/debates/${id} failed (${debateRes.status})`);
const debate = await debateRes.json();
const models: ModelInfo[] = modelsRes.ok ? (await modelsRes.json()).models : [];

const debater = (side: 'for' | 'against') => debaterLabel(debate.debaters[side], models);
const speakers = { for: debater('for'), against: debater('against') };
const isBatch = debate.kind === 'batch';
// API Debaters' Turns are labelled as submitted via API, not as AI-generated (ADR 0005).
const apiSides = (['for', 'against'] as const).filter(side => debate.debaters[side].kind === 'api');
---

<Base title={debate.motion} description={t('debate.description', { motion: debate.motion })} canonicalPath={`/debates/${debate.id}`} wide>
  <DebateBand slot="band" debate={debate} models={models} signedIn={me !== null} />

  {debate.visibility === 'unlisted' && debate.mine && <p class="note">{t('unlisted.mine')}</p>}
  {isBatch && debate.status === 'running' && <p class="note" role="status">{t('batch.generating')}</p>}
  {isBatch && debate.status === 'complete' && <p class="muted">{t('batch.noVotes')}</p>}

  {/* data-region: the before-vote brings the hidden Turns in without a reload, with focus on them (lib/refresh).
      On request only: the end of a live Debate and the after-vote leave the floor as it is. */}
  <div data-region="turns" data-on-request>
  <section id="turns" tabindex="-1" aria-label={t('debate.turns')}>
    {
      debate.turnsHidden ? (
        <p class="note">{t('debate.turnsHidden')}</p>
      ) : debate.status === 'running' && !isBatch ? (
        <LiveTurns
          client:load
          debateId={debate.id}
          format={debate.format}
          speakers={speakers}
          initialTurns={debate.turns}
          apiSides={apiSides}
          initialAwaiting={debate.awaiting?.slotIndex ?? null}
        />
      ) : debate.turns.length === 0 ? (
        <p class="muted">{t('debate.noTurns')}</p>
      ) : (
        <PhaseFloor format={debate.format} turns={debate.turns} speakers={speakers} apiSides={apiSides} />
      )
    }
  </section>
  </div>

  <DebateOutcome debate={debate} models={models} signedIn={me !== null} />

  <DebateRecord debate={debate} models={models} signedIn={me !== null} />

  <nav class="onward" aria-label={t('debate.onward')}>
    <a href="/">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
        ><path d="M19 12H5"></path><path d="M11 6l-6 6 6 6"></path></svg
      >
      {t('debate.onward')}
    </a>
    <a href="/new">{t('debate.startOwn')}</a>
  </nav>

  {/* What a fresh render of the page changed, said once (lib/refresh); outside every swapped region. */}
  <p id="debate-announcer" class="visually-hidden" role="status"></p>
</Base>

<style>
  /* Focused only by script, as a place to read on from: no ring around the whole floor (as with the Verdict). */
  #turns:focus {
    outline: none;
  }
  .onward {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    max-width: 52rem;
    margin: calc(var(--space) * 2) auto 0;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .onward a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-weight: 600;
  }
</style>
