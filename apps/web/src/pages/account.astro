---
import PageHead from '../components/PageHead.astro';
import AccountActions from '../islands/AccountActions.svelte';
import SignInButton from '../islands/SignInButton.svelte';
import Base from '../layouts/Base.astro';
import { t, tn } from '../i18n/t';
import { DEBATE_QUOTA_POINTS } from '../lib/debate';

const { me } = Astro.locals;
---

<Base title={t('account.title')} description={t('account.description')} canonicalPath="/account" noindex>
  {
    me ? (
      <PageHead slot="band" title={t('account.title')}>
        <p>{t('account.name', { name: me.name })}</p>
        <p>{tn('account.quota', me.quotaRemaining, { cost: DEBATE_QUOTA_POINTS })}</p>
      </PageHead>
    ) : (
      <PageHead slot="band" title={t('account.title')} />
    )
  }
  {
    me ? (
      <>
        <section class="stack" aria-labelledby="data-title">
          <h2 id="data-title">{t('account.dataTitle')}</h2>
          <p class="muted">{t('account.exportHint')}</p>
          <p>
            <a class="button secondary" href="/api/me/export" download="debate-arena-export.json">
              {t('account.export')}
            </a>
          </p>
        </section>
        <AccountActions client:visible />
      </>
    ) : (
      <div class="stack">
        <p>{t('account.signIn')}</p>
        <SignInButton client:load callbackPath="/account" />
      </div>
    )
  }
</Base>
