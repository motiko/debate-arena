---
import SignInButton from '../islands/SignInButton.svelte';
import StartDebateForm from '../islands/StartDebateForm.svelte';
import Base from '../layouts/Base.astro';
import { t } from '../i18n/t';

const { api, me } = Astro.locals;
let models: { id: string; label: string; roles: string[]; batch?: boolean }[] = [];
if (me) {
  const response = await api.api.models.$get();
  if (!response.ok) throw new Error(`GET /api/models failed (${response.status})`);
  models = (await response.json()).models;
}
---

<Base title={t('new.title')} description={t('new.description')} canonicalPath="/new">
  <header slot="band" class="page-head">
    <h1>{t('new.title')}</h1>
    <p>{t('new.description')}</p>
  </header>
  {
    me ? (
      <StartDebateForm client:load models={models} quotaRemaining={me.quotaRemaining} />
    ) : (
      <div class="stack">
        <p>{t('new.signIn')}</p>
        <SignInButton client:load callbackPath="/new" />
      </div>
    )
  }
</Base>

<style>
  /* In the bench-green band like the top of a Debate page, kept to the form's measure so the two line up. */
  .page-head {
    max-width: var(--measure);
    margin-inline: auto;
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.75rem);
  }
  .page-head h1 {
    font-size: clamp(2rem, 1.3rem + 3vw, 3rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
  }
  .page-head p {
    margin-top: 0.6rem;
    max-width: 38rem;
    color: var(--band-muted);
  }
</style>
