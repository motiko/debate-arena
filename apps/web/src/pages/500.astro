---
import PageHead from '../components/PageHead.astro';
import Base from '../layouts/Base.astro';
import { t } from '../i18n/t';
---

<Base title={t('error.title')} description={t('error.body')} canonicalPath="/500" noindex>
  <PageHead slot="band" title={t('error.title')}><p>{t('error.body')}</p></PageHead>
  <p><a class="button" href="/">{t('notFound.home')}</a></p>
</Base>
