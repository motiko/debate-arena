---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import { t } from '../i18n/t';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  /** The wide column (band and floor) for the main content, instead of the reading measure. */
  wide?: boolean;
}

const { title, description, canonicalPath, noindex = false, wide = false } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{`${title} · ${t('site.name')}`}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#1d5c45" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#173a2c" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-serif" preload />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('site.skip')}</a>
    <header class="site-header band">
      <div class="wrap-wide">
        <a class="brand" href="/"><span class="lozenge" aria-hidden="true"></span>{t('site.name')}</a>
        <Header />
      </div>
    </header>
    <main id="main" tabindex="-1">
      {
        Astro.slots.has('band') && (
          <div class="band">
            <div class="wrap-wide">
              <slot name="band" />
            </div>
          </div>
        )
      }
      <div class:list={[wide ? 'wrap-wide' : 'wrap', 'main-body']}>
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap-wide">
        <p>{t('site.aiNotice')}</p>
        <nav aria-label={t('legal.nav')} class="legal-nav">
          <a href="/impressum">{t('legal.impressum')}</a>
          <a href="/privacy">{t('legal.privacy')}</a>
          <a href="/terms">{t('legal.terms')}</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
