  },
  "scripts": {
    "dev": "wrangler d1 migrations apply DB --local && WRANGLER_REGISTRY_PATH=../../.wrangler/dev-registry wrangler dev --var DEV_AUTH:true --var BETTER_AUTH_URL:http://localhost:4321",
