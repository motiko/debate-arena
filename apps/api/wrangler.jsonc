{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "debate-arena-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "debate-arena",
      // Local-only id. The real EU-jurisdiction database is created in Plan 7:
      // wrangler d1 create debate-arena --jurisdiction=eu
      "database_id": "local-debate-arena",
      "migrations_dir": "migrations"
    }
  ],
  "queues": {
    "producers": [{ "binding": "STEP_QUEUE", "queue": "debate-steps" }],
    "consumers": [
      { "queue": "debate-steps", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "dead_letter_queue": "debate-steps-dlq" }
    ]
  },
  "durable_objects": {
    "bindings": [{ "name": "DEBATE_ROOM", "class_name": "DebateRoom" }]
  },
  "exports": {
    "DebateRoom": { "type": "durable-object", "storage": "sqlite" }
  },
  // MODERATOR_GITHUB_IDS: comma-separated GitHub numeric user ids of Moderators (empty: nobody).
  // EMAIL_PROVIDER: "none" (log only) or "scaleway" (needs SCALEWAY_SECRET_KEY, SCALEWAY_PROJECT_ID and EMAIL_FROM).
  "vars": {
    "MODEL_PROVIDER": "fake",
    "DEV_AUTH": "false",
    "BETTER_AUTH_URL": "http://localhost:8787",
    "MODERATOR_GITHUB_IDS": "",
    "EMAIL_PROVIDER": "none",
    "EMAIL_FROM": ""
  },
  // Bindings and vars are not inherited by environments, so production repeats them.
  "env": {
    "production": {
      // REPLACE_ME values must be filled in before the first production deploy (see DEPLOY.md);
      // `node scripts/check-release.mjs` refuses to deploy while any remain.
      "vars": {
        "MODEL_PROVIDER": "openrouter",
        "DEV_AUTH": "false",
        // The web Worker's address, e.g. https://debate-arena-web.<subdomain>.workers.dev
        "BETTER_AUTH_URL": "REPLACE_ME_PRODUCTION_URL",
        "MODERATOR_GITHUB_IDS": "",
        "EMAIL_PROVIDER": "none",
        "EMAIL_FROM": ""
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "debate-arena",
          // From `wrangler d1 create debate-arena --jurisdiction=eu` (EU jurisdiction: Member data stays in the EU).
          "database_id": "REPLACE_ME_D1_ID",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "STEP_QUEUE", "queue": "debate-steps-production" }],
        "consumers": [
          {
            "queue": "debate-steps-production",
            "max_batch_size": 1,
            "max_batch_timeout": 0,
            "max_retries": 3,
            "dead_letter_queue": "debate-steps-production-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [{ "name": "DEBATE_ROOM", "class_name": "DebateRoom" }]
      }
    }
  }
}
