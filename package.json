{
  "name": "debate-arena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "debate": "node packages/cli/src/main.ts",
    "lint": "oxlint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:scripts": "node --test 'scripts/*.test.mjs'",
    "check:release": "node scripts/check-release.mjs",
    "check": "pnpm lint && pnpm test:scripts && turbo run typecheck test",
    "ship": "node scripts/ship.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "oxlint": "^1.93.0",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  }
}
